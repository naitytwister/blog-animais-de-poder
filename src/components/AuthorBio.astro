---
import { AUTHOR } from '../lib/consts';

interface Props {
  name?: string;
}

const { name = AUTHOR.name } = Astro.props;
const isAuthor = name === AUTHOR.name;
const avatarSrc = isAuthor ? AUTHOR.avatar : undefined;
---

<aside class="author" itemscope itemtype="https://schema.org/Person">
  <a class="author-avatar" href={isAuthor ? AUTHOR.pagePath : '/sobre/'} aria-hidden="true" tabindex="-1">
    {avatarSrc ? (
      <img src={avatarSrc} alt="" width="64" height="64" loading="lazy" decoding="async" />
    ) : (
      <span>{name.charAt(0)}</span>
    )}
  </a>
  <div class="author-info">
    <p class="author-label">Escrito por</p>
    <h3 itemprop="name">
      <a href={isAuthor ? AUTHOR.pagePath : '/sobre/'} itemprop="url">
        {name}
      </a>
    </h3>
    <p itemprop="jobTitle" class="author-role">{AUTHOR.role}</p>
    <a class="author-link" href={isAuthor ? AUTHOR.pagePath : '/sobre/'}>
      Conheça a autora e a missão do blog
    </a>
  </div>
</aside>

<style>
  .author {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    margin-top: var(--space-7);
    padding: var(--space-6);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .author-avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--indigo), var(--amber));
    display: grid;
    place-items: center;
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    overflow: hidden;
    text-decoration: none;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
    margin-bottom: var(--space-1);
  }

  .author h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-xl);
  }

  .author h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .author h3 a:hover {
    color: var(--amber);
  }

  .author-role {
    font-size: var(--text-sm);
    color: var(--text-soft);
    margin: 0 0 var(--space-3);
  }

  .author-link {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
