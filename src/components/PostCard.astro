---
import type { CollectionEntry } from 'astro:content';
import { SUBNICHOS } from '../lib/consts';
import { formatDate, readingTime } from '../lib/utils';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { data } = post;
const subnicho = SUBNICHOS[data.subnicho];
const read = readingTime(post.body ?? '');
---

<article class:list={['card', { 'card-featured': featured }]}>
  <a class="card-link" href={`/posts/${post.id}/`}>
    <div class="card-cover">
      <img
        src={data.imagem_capa}
        alt={data.imagem_alt}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
        width="1200"
        height="800"
      />
      <span class="card-tipo">{data.tipo === 'pilar' ? 'Guia Completo' : 'Artigo'}</span>
    </div>
    <div class="card-body">
      <div class="card-meta">
        <span class="card-cat">{subnicho.titulo}</span>
        <span aria-hidden="true">·</span>
        <span>{formatDate(data.data)}</span>
      </div>
      <h3>{data.title}</h3>
      <p class="card-desc">{data.description}</p>
      <span class="card-read">{read}</span>
    </div>
  </a>
</article>

<style>
  .card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-cover {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }

  .card:hover .card-cover img {
    transform: scale(1.03);
  }

  .card-tipo {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: color-mix(in srgb, var(--indigo) 85%, transparent);
    color: var(--white);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
    border-radius: 999px;
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-soft);
    margin-bottom: var(--space-3);
  }

  .card-cat {
    color: var(--amber);
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
    line-height: 1.3;
  }

  .card:hover h3 {
    color: var(--accent-ink);
  }

  .card-desc {
    font-size: var(--text-sm);
    color: var(--text-soft);
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .card-featured {
    grid-column: 1 / -1;
  }

  .card-featured .card-body {
    padding: var(--space-7);
  }

  .card-featured h3 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    max-width: 22ch;
  }
</style>
