---
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USER || 'animotem';
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="newsletter-inner">
    <h3 id="newsletter-title">Receba um sinal do reino animal</h3>
    <p>
      Novos guias, interpretações de sonhos e oráculos, direto no seu e-mail. Sem spam, apenas
      escuta.
    </p>
    <form
      class="newsletter-form"
      method="post"
      action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
      target="popupwindow"
      onsubmit="window.open('https://buttondown.com/${buttondownUser}', 'popupwindow', 'scrollbars=yes,width=800,height=600'); return true;"
    >
      <label class="sr-only" for="newsletter-email">Seu e-mail</label>
      <input
        id="newsletter-email"
        type="email"
        name="email"
        required
        placeholder="seu@email.com"
        autocomplete="email"
      />
      <button type="submit">Assinar</button>
      <p class="newsletter-note">Você pode cancelar a assinatura quando quiser.</p>
    </form>
  </div>
</section>

<style>
  .newsletter {
    margin-top: var(--space-7);
  }

  .newsletter-inner {
    background: linear-gradient(135deg, var(--indigo), var(--indigo-soft));
    color: var(--white);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    box-shadow: var(--shadow-glow);
    text-align: center;
  }

  .newsletter h3 {
    color: var(--amber);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    margin-bottom: var(--space-3);
  }

  .newsletter p {
    color: rgba(255, 255, 255, 0.85);
    max-width: 42ch;
    margin-inline: auto;
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-3);
    max-width: 30rem;
    margin: var(--space-5) auto 0;
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-form input {
    flex: 1 1 14rem;
    padding: var(--space-3) var(--space-4);
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    font-size: var(--text-sm);
  }

  .newsletter-form button {
    padding: var(--space-3) var(--space-5);
    background: var(--amber);
    color: var(--ink);
    border: none;
    border-radius: var(--radius);
    font-family: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .newsletter-form button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .newsletter-form .newsletter-note {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    margin-top: var(--space-2);
    flex-basis: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 520px) {
    .newsletter-form {
      flex-direction: column;
    }

    .newsletter-form input {
      flex-basis: auto;
    }
  }
</style>
