---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Trilha de navegação">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
        {index < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--text-soft);
  }

  .breadcrumbs a {
    color: var(--text-soft);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }

  .sep {
    margin-inline: var(--space-1);
    color: var(--text-soft);
    opacity: 0.5;
  }
</style>
