---
import { SITE, SUBNICHOS } from '../lib/consts';
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">☽ {SITE.shortName}</a>
      <p class="footer-tagline">
        Um espaço de escuta para os saberes ancestrais: animais de poder, sonhos e os sinais que
        o mundo natural nos oferece. Conteúdo informativo e cultural, com respeito às tradições.
      </p>
      <p class="footer-note">
        Os conteúdos têm caráter informativo e simbólico e não substituem apoio profissional de
        saúde. Em caso de sofrimento, procure um profissional qualificado.
      </p>
    </div>

    <nav class="footer-col" aria-label="Explorar">
      <h3>Explorar</h3>
      {Object.entries(SUBNICHOS).map(([, s]) => (
        <a href={`/categoria/${s.slug_categoria}/`}>{s.titulo}</a>
      ))}
    </nav>

    <nav class="footer-col" aria-label="Institucional">
      <h3>Institucional</h3>
      <a href="/sobre/">Sobre</a>
      <a href="/autora/">A autora</a>
      <a href="/apoie/">Apoie o projeto</a>
      <a href="/contato/">Contato</a>
      <a href="/termos/">Termos de Uso</a>
      <a href="/privacidade/">Política de Privacidade</a>
      <a href="/cookies/">Política de Cookies</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>© {new Date().getFullYear()} {SITE.name}. Todos os direitos reservados.</p>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-9);
    background: var(--bg-ink);
    color: var(--white);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    color: var(--white);
    text-decoration: none;
  }

  .footer-tagline {
    color: rgba(255, 255, 255, 0.8);
    margin-top: var(--space-4);
    max-width: 40ch;
  }

  .footer-note {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
    border-left: 3px solid var(--amber);
    padding-left: var(--space-3);
    margin-top: var(--space-5);
  }

  .footer-col h3 {
    color: var(--amber);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-4);
  }

  .footer-col a {
    display: block;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    transition: color var(--transition);
  }

  .footer-col a:hover {
    color: var(--amber);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: var(--space-4);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }

  .footer-bottom-inner a {
    color: var(--amber);
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
