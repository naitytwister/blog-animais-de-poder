---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBio from '../components/AuthorBio.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RatingStars from '../components/RatingStars.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, SUBNICHOS, AUTHOR } from '../lib/consts';
import { formatDate, formatDateIso, readingTime } from '../lib/utils';
import { extractFaq } from '../lib/faq';

interface Props {
  post: CollectionEntry<'posts'>;
  related: CollectionEntry<'posts'>[];
}

const { post, related } = Astro.props;
const { data, body, id } = post;
const { Content } = await render(post);

const canonicalPath = `/posts/${id}/`;
const canonical = `${SITE.url}${canonicalPath}`;
const cover = `${SITE.url}${data.imagem_capa}`;
const subnicho = SUBNICHOS[data.subnicho];
const faq = extractFaq(body ?? '');
const reading = readingTime(body ?? '');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: [cover],
  datePublished: formatDateIso(data.data),
  dateModified: formatDateIso(data.data),
  author: {
    '@type': 'Person',
    name: data.autor,
    url: `${SITE.url}${AUTHOR.pagePath}`,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonical,
  },
  inLanguage: SITE.locale,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: subnicho.titulo,
      item: `${SITE.url}/categoria/${subnicho.slug_categoria}/`,
    },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ],
};

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={cover}
  type="article"
  canonicalPath={canonicalPath}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="post">
    <header class="post-hero">
      <div class="container-narrow">
        <Breadcrumbs
          items={[
            { label: 'Início', href: '/' },
            { label: subnicho.titulo, href: `/categoria/${subnicho.slug_categoria}/` },
            { label: data.title },
          ]}
        />
        <div class="post-meta">
          <a class="chip" href={`/categoria/${subnicho.slug_categoria}/`}>
            {subnicho.titulo}
          </a>
          {data.tipo === 'pilar' && <span class="chip chip-pilar">Guia Completo</span>}
          <span class="chip chip-meta">{reading}</span>
          <time class="chip chip-meta" datetime={formatDateIso(data.data)}>
            {formatDate(data.data)}
          </time>
        </div>
        <h1>{data.title}</h1>
        <p class="post-description">{data.description}</p>
        <ShareButtons title={data.title} url={canonical} />
      </div>
    </header>

    <div class="post-cover">
      <div class="container-narrow">
        <img src={data.imagem_capa} alt={data.imagem_alt} width="1200" height="800" />
      </div>
    </div>

    <div class="post-body">
      <div class="container-narrow">
        <AdSlot position="topo" />
        <RatingStars slug={id} />
        <div class="prose">
          <Content />
        </div>
        <AdSlot position="final" />

        <div class="post-footer-meta">

          <p class="kw">Busca principal: <strong>{data.palavra_chave}</strong></p>
          <ShareButtons title={data.title} url={canonical} />
        </div>

        {faq.length > 0 && (
          <div class="faq" id="faq">
            <h2>Perguntas Frequentes</h2>
            {faq.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        )}

        <AuthorBio name={data.autor} />
        <Newsletter />
      </div>
    </div>

    {related.length > 0 && <RelatedPosts posts={related} currentSlug={id} />}
  </article>
</BaseLayout>

<style>
  .post-hero {
    padding-block: var(--space-7) var(--space-5);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-4);
  }

  .chip {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3em 0.8em;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    color: var(--text-soft);
    text-decoration: none;
  }

  .chip:hover {
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .chip-pilar {
    background: var(--amber);
    color: var(--ink);
    border-color: transparent;
  }

  .post-hero h1 {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-5xl));
    margin-bottom: var(--space-4);
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--text-soft);
    max-width: 46ch;
  }

  .post-cover img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-6);
  }

  .prose {
    font-size: var(--text-lg);
  }

  .post-footer-meta {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .kw {
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .faq {
    margin-top: var(--space-7);
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .faq-item summary {
    cursor: pointer;
    padding: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    list-style: none;
    position: relative;
    padding-right: var(--space-8);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    right: var(--space-5);
    color: var(--amber);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    padding: 0 var(--space-5) var(--space-4);
    margin: 0;
    color: var(--text-soft);
  }
</style>
