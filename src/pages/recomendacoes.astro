---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AmazonProductCard from '../components/AmazonProductCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../lib/consts';
import { CURATED_PRODUCTS } from '../lib/amazon';

const books = CURATED_PRODUCTS.filter(p => p.category === 'livro');
const oracles = CURATED_PRODUCTS.filter(p => p.category === 'oraculo');
const toolsAndRituals = CURATED_PRODUCTS.filter(p => p.category === 'ritual' || p.category === 'ferramenta');
---

<BaseLayout
  title={`Livros, Oráculos e Instrumentos Recomendados — ${SITE.shortName}`}
  description="Seleção curada de livros de xamanismo, baralhos de animais de poder, oráculos sagrados e ferramentas rituais para aprofundar seu autoconhecimento."
  canonicalPath="/recomendacoes/"
>
  <article class="page">
    <div class="container-narrow">
      <Breadcrumbs items={[{ label: 'Início', href: '/' }, { label: 'Recomendações' }]} />

      <header class="hero">
        <h1>Livros, Oráculos & Instrumentos Recomendados</h1>
        <p class="hero-sub">
          Para quem deseja se aprofundar no estudo dos animais de poder, no simbolismo ancestral e na prática xamânica, selecionamos os melhores livros, baralhos de cartas, instrumentos e materiais de purificação.
        </p>
      </header>

      <div class="category-nav">
        <a href="#oraculos" class="cat-pill">🃏 Oráculos ({oracles.length})</a>
        <a href="#livros" class="cat-pill">📚 Livros ({books.length})</a>
        <a href="#rituais" class="cat-pill">🌿 Rituais & Ferramentas ({toolsAndRituals.length})</a>
      </div>

      <section id="oraculos" class="recommendation-section">
        <div class="section-header">
          <h2>🃏 Baralhos & Oráculos Sagrados</h2>
          <p>Ferramentas intuitivas para tiragens diárias, meditação e conexão com a medicina animal.</p>
        </div>
        <div class="products-grid">
          {oracles.map((product) => (
            <AmazonProductCard product={product} />
          ))}
        </div>
      </section>

      <section id="livros" class="recommendation-section">
        <div class="section-header">
          <h2>📚 Livros & Guias de Estudo</h2>
          <p>Obras essenciais sobre xamanismo, antropologia, simbolismo animal e jornadas espirituais.</p>
        </div>
        <div class="products-grid">
          {books.map((product) => (
            <AmazonProductCard product={product} />
          ))}
        </div>
      </section>

      <section id="rituais" class="recommendation-section">
        <div class="section-header">
          <h2>🌿 Instrumentos & Rituais Xamânicos</h2>
          <p>Ferramentas de defumação, ressonância sonora e pedras naturais para altares e jornadas.</p>
        </div>
        <div class="products-grid">
          {toolsAndRituals.map((product) => (
            <AmazonProductCard product={product} />
          ))}
        </div>
      </section>

      <div class="affiliate-disclosure">
        <p>
          🔒 <strong>Transparência Editorial:</strong> Ao comprar através dos links acima na Amazon, o {SITE.shortName} recebe uma pequena comissão de afiliado sem nenhum custo adicional para você. Isso ajuda a manter nossos guias, testes e pesquisas 100% gratuitos.
        </p>
      </div>

      <Newsletter />
    </div>
  </article>
</BaseLayout>

<style>
  .hero {
    margin-block: var(--space-6) var(--space-6);
  }

  .hero h1 {
    font-size: var(--text-2xl);
    font-weight: 800;
    margin-bottom: var(--space-2);
  }

  .hero-sub {
    font-size: var(--text-base);
    color: var(--text-soft);
    line-height: 1.6;
  }

  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cat-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .recommendation-section {
    margin-bottom: var(--space-10);
    scroll-margin-top: var(--space-6);
  }

  .section-header {
    margin-bottom: var(--space-4);
    border-bottom: 2px solid var(--border);
    padding-bottom: var(--space-2);
  }

  .section-header h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-1);
  }

  .section-header p {
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .products-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .affiliate-disclosure {
    background: var(--bg-elev);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-soft);
    margin-bottom: var(--space-8);
  }
</style>
