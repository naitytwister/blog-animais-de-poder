# URL pública do site (canonical, sitemap, OG). Obrigatório no build de produção.
PUBLIC_SITE_URL=https://animotem.com

# Nome da autora (fallback do frontmatter dos posts).
BLOG_AUTHOR=Cecília Aranha

# Client ID do AdSense (ca-pub-...). Vazio = anúncios desativados.
# PUBLIC_ADSENSE_CLIENT=

# Usuário do Buttondown para o embed da newsletter.
PUBLIC_BUTTONDOWN_USER=animotem

# URL do perfil Ko-fi (fallback do botão na página /apoie/).
PUBLIC_KOFI_URL=https://ko-fi.com/animotem

# URL base do Worker de avaliações (Cloudflare). Vazio/placeholder = widget oculto.
# Ex.: https://animotem-ratings.SEU_SUBDOMINIO.workers.dev
# PUBLIC_RATINGS_API_URL=

# Token do Cloudflare Web Analytics (beacon). Vazio/ausente = usa o token embutido
# em src/lib/consts.ts (já configurado para animotem.com).
# Defina aqui apenas para trocar de site sem alterar o código.
# PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
